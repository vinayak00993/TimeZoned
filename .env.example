# Canonical site origin used for metadata, sitemap.xml and robots.txt.
# Defaults to https://www.gettimezoned.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.gettimezoned.com

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value of the
# "google-site-verification" meta tag). Leave empty if you verify via DNS.
GOOGLE_SITE_VERIFICATION=
